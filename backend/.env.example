# VIGIL-AI Backend Configuration
APP_NAME=VIGIL-AI
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Networking
HOST=0.0.0.0
PORT=8000

# Authentication & Security (Mandatory high-entropy secret in production)
JWT_SECRET_KEY=change-this-in-production-use-a-32-byte-hex-key-minimum
API_KEY=vigil-ai-hackathon-demo-key-2026
ALLOW_ANONYMOUS_DEV=true

# Pipeline Parameters
SAMPLE_RATE=16000
CHUNK_WINDOW_SECONDS=1.5
CHUNK_HOP_SECONDS=0.5
VAD_CONFIDENCE_THRESHOLD=0.50

# Thresholds for Decision Engine
ALLOW_THRESHOLD=0.25
WARN_THRESHOLD=0.60
BLOCK_THRESHOLD=0.85
HIGH_UNCERTAINTY_THRESHOLD=0.60

# Device Acceleration (cpu | cuda | directml)
INFERENCE_DEVICE=cpu

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres
DETECTION_STORE_BACKEND=supabase

# Database & Redis (Optional for standalone demo / development)
DATABASE_URL=sqlite+aiosqlite:///./vigil_dev.db
REDIS_URL=redis://localhost:6379/0
